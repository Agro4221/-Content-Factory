# Runtime configuration template. Put real values only in .env.
# Everything here can also be filled in the local admin panel.

# --- Local web panel ---
API_HOST=127.0.0.1
API_PORT=8000
API_LOG_LEVEL=warning
BROWSER_OPEN_ON_START=1
BROWSER_OPEN_DELAY_S=2.5

# Admin panel credentials. Mandatory when API_HOST is not loopback.
ADMIN_USERNAME=
ADMIN_PASSWORD=

# --- Telegram ---
TG_API_ID=
TG_API_HASH=
BOT_TOKEN=

# --- Cloud AI (OpenAI-compatible: OpenRouter, DeepSeek, Groq, ...) ---
REMOTE_URL=
REMOTE_API_KEY=

# --- Proxy ---
PROXY_HOST=
PROXY_PORT=
PROXY_USER=
PROXY_PASS=
